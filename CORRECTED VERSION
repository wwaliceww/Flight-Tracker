  <script>
    // 1. Your flight data
    const flights = [
      {
        date: "2023-06-14",
        from: "FCO",
        fromName: "Rome Fiumicino",
        fromLat: 41.8003,
        fromLng: 12.2389,
        to: "CDG",
        toName: "Paris Charles de Gaulle",
        toLat: 49.0097,
        toLng: 2.5479,
        distance_km: 1105,
        duration_min: 120,
        who: "her",
        notes: "First trip to meet in Paris after months of texting 🥹"
      },
      {
        date: "2023-08-02",
        from: "JFK",
        fromName: "New York JFK",
        fromLat: 40.6413,
        fromLng: -73.7781,
        to: "FCO",
        toName: "Rome Fiumicino",
        toLat: 41.8003,
        toLng: 12.2389,
        distance_km: 6898,
        duration_min: 510,
        who: "him",
        notes: "He flew to see me in Rome for the summer 🇮🇹"
      }
      // Add more flights here…
    ];

    // 2. Compute stats
    function computeStats(flights) {
      const totalFlights = flights.length;
      let totalDistance = 0;
      let totalMinutes = 0;
      const airportCounts = {};
      const years = new Set();
      let herFlights = 0;
      let hisFlights = 0;

      flights.forEach(f => {
        totalDistance += f.distance_km || 0;
        totalMinutes += f.duration_min || 0;

        if (f.who === "her") herFlights++;
        if (f.who === "him") hisFlights++;

        const date = new Date(f.date);
        if (!isNaN(date)) years.add(date.getFullYear());

        [f.fromName, f.toName].forEach(name => {
          if (!name) return;
          airportCounts[name] = (airportCounts[name] || 0) + 1;
        });
      });

      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;

      const sortedDestinations = Object.entries(airportCounts)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 5);

      return {
        totalFlights,
        totalDistance,
        hours,
        minutes,
        totalMinutes,      // <— NEW: return total minutes
        herFlights,
        hisFlights,
        sortedDestinations,
        years: Array.from(years).sort()
      };
    }

    const stats = computeStats(flights);

    // 3. Render stats in the side panel
    document.getElementById("total-flights").textContent = stats.totalFlights;

    const flightYearsEl = document.getElementById("flight-years");
    if (stats.years.length === 1) {
      flightYearsEl.textContent = `Since ${stats.years[0]}`;
    } else if (stats.years.length > 1) {
      flightYearsEl.textContent = `${stats.years[0]}–${stats.years[stats.years.length - 1]}`;
    }

    document.getElementById("total-distance").textContent =
      `${stats.totalDistance.toLocaleString()} km`;

    const aroundEarthKm = 40075;
    const distanceSubEl = document.getElementById("distance-subtext");
    if (stats.totalDistance > 0) {
      const laps = stats.totalDistance / aroundEarthKm;
      distanceSubEl.textContent = `${laps.toFixed(2)} × around the Earth 🌍`;
    } else {
      distanceSubEl.textContent = "";
    }

    document.getElementById("total-time").textContent =
      `${stats.hours} h ${stats.minutes} min`;

    // NEW: total time including way home
    const totalMinutesReturns = stats.totalMinutes * 2;
    const hoursReturns = Math.floor(totalMinutesReturns / 60);
    const minutesReturns = totalMinutesReturns % 60;
    document.getElementById("total-time-returns").textContent =
      `${hoursReturns} h ${minutesReturns} min`;

    document.getElementById("her-his-flights").textContent =
      `Her: ${stats.herFlights} · Him: ${stats.hisFlights}`;

    const topDestinationsEl = document.getElementById("top-destinations");
    topDestinationsEl.innerHTML = "";
    stats.sortedDestinations.forEach(([name, count]) => {
      const li = document.createElement("li");
      li.textContent = `${name}: ${count} flights`;
      topDestinationsEl.appendChild(li);
    });

    const flightLogEl = document.getElementById("flight-log");
    const sortedFlights = [...flights].sort((a, b) => {
      const da = new Date(a.date);
      const db = new Date(b.date);
      return da - db;
    });

    sortedFlights.forEach(f => {
      const li = document.createElement("li");
      const whoLabel = f.who === "her" ? "her flight" : f.who === "him" ? "his flight" : "both";
      li.innerHTML = `
        <div class="flight-log-date">${f.date}</div>
        <div class="flight-log-route">${f.from} → ${f.to} (${whoLabel})</div>
        <div class="flight-log-notes">${f.notes ? f.notes : "No notes yet"}</div>
      `;
      flightLogEl.appendChild(li);
    });

    // 4. 3D globe with arcs
    const globeElement = document.getElementById("globeViz");
    const infoPanel = document.getElementById("flight-info");

    const world = Globe()
      (globeElement)
      .globeImageUrl("//unpkg.com/three-globe/example/img/earth-dark.jpg")
      .bumpImageUrl("//unpkg.com/three-globe/example/img/earth-topology.png")
      .backgroundColor("rgba(0,0,0,0)")
      .showAtmosphere(true)
      .atmosphereColor("#38bdf8")
      .atmosphereAltitude(0.22)
      .arcStartLat(d => d.fromLat)
      .arcStartLng(d => d.fromLng)
      .arcEndLat(d => d.toLat)
      .arcEndLng(d => d.toLng)
      .arcAltitude(d => 0.2)
      .arcStroke(0.6)
      .arcDashLength(0.4)
      .arcDashGap(0.9)
      .arcDashAnimateTime(2500)
      .arcLabel(d => {
        const whoLabel = d.who === "her" ? "Her flight" : d.who === "him" ? "His flight" : "Our flight";
        return `${whoLabel}\n${d.fromName} → ${d.toName}\n${d.date}\n${d.distance_km.toLocaleString()} km · ${Math.round(d.duration_min / 60)} h ${d.duration_min % 60} min\n${d.notes || ""}`;
      })
      .arcColor(d => d.who === "her" ? "#a855f7" : "#38bdf8");
    const world = Globe()(globeElement)
      .globeImageUrl("https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg")
      .backgroundColor("rgba(0,0,0,0)");

    world.arcsData(flights);
    // ✅ FIX: force correct sizing
    world.width(globeElement.clientWidth);
    world.height(globeElement.clientHeight);

    world.pointOfView({ lat: 25, lng: 5, altitude: 2.1 }, 0);

    const controls = world.controls();
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.45;
    // ✅ FIX: keep responsive
    window.addEventListener("resize", () => {
      world.width(globeElement.clientWidth);
      world.height(globeElement.clientHeight);
    });
  </script>
